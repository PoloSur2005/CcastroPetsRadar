#cloud-config
# ------------------------------------------------------------------------------
# Plantilla cloud-init (formato cloud-config). El droplet la ejecuta UNA vez, en
# su primer arranque. Lo que ves como $${variable} lo sustituye Terraform
# (templatefile) ANTES de subir el archivo al servidor.
# Flujo: crea swap -> instala Docker -> clona el repo -> escribe .env -> compose up.
# ------------------------------------------------------------------------------
package_update: true
package_upgrade: false

write_files:
  # Archivo .env con los secretos, inyectados desde las variables de Terraform.
  # Queda solo en el droplet (root, 0600); nunca se sube al repositorio.
  - path: /root/petradar.env
    permissions: '0600'
    owner: root:root
    content: |
      PORT=${app_port}

      DB_HOST=db
      DB_PORT=5432
      DB_USER=${db_user}
      DB_PASSWORD=${db_password}
      DB_NAME=${db_name}

      MAILER_SERVICE=${mailer_service}
      MAILER_EMAIL=${mailer_email}
      MAILER_PASSWORD=${mailer_password}
      MAPBOX_TOKEN=${mapbox_token}

      APPLICATIONINSIGHTS_CONNECTION_STRING=${appinsights_connection_string}

      REDIS_HOST=redis
      REDIS_PORT=6379

  # Script de despliegue. Se mantiene aparte para poder re-ejecutarlo a mano si
  # algo falla (bash /root/deploy.sh).
  - path: /root/deploy.sh
    permissions: '0755'
    owner: root:root
    content: |
      #!/usr/bin/env bash
      set -euxo pipefail

      # --- 1) Swap: evita quedarse sin memoria durante el build en 1 GB de RAM ---
      if [ ! -f /swapfile ]; then
        fallocate -l ${swap_size_mb}M /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=${swap_size_mb}
        chmod 600 /swapfile
        mkswap /swapfile
        swapon /swapfile
        echo '/swapfile none swap sw 0 0' >> /etc/fstab
      fi

      # --- 2) Docker Engine + plugin docker compose (repositorio oficial) -------
      export DEBIAN_FRONTEND=noninteractive
      apt-get update
      apt-get install -y ca-certificates curl gnupg git
      install -m 0755 -d /etc/apt/keyrings
      curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
      chmod a+r /etc/apt/keyrings/docker.gpg
      echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian $(. /etc/os-release && echo "$VERSION_CODENAME") stable" > /etc/apt/sources.list.d/docker.list
      apt-get update
      apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
      systemctl enable --now docker

      # --- 3) Clonar el repositorio --------------------------------------------
      mkdir -p /opt
      if [ ! -d /opt/petradar/.git ]; then
        git clone --branch ${repo_branch} ${repo_url} /opt/petradar
      fi
      cd /opt/petradar

      # --- 4) Colocar el .env dentro del repo clonado --------------------------
      cp /root/petradar.env /opt/petradar/.env

      # --- 5) Construir la imagen y levantar DB + Redis + API -------------------
      docker compose up --build -d

      echo "petradar deploy finished" > /root/deploy.done

runcmd:
  - bash /root/deploy.sh
